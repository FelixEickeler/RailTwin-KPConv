# Copy to docker/.env and adapt (docker/.env is not committed)
DATA_DIR=/path/to/datasets
WORK_DIR=/path/to/workdir
# Your user and group id (id -u / id -g), so files written in the container belong to you
LOCAL_UID=1000
LOCAL_GID=1000
# ssh login as point_warrior (e.g. PyCharm: SSH interpreter /usr/bin/python3, path mapping
# <repo> -> /home/point_warrior/railtwin_kpconv). Password and / or public key(s); both empty = ssh disabled.
# The ssh port is reachable from the network: change the password.
SSH_PASSWORD=slice
SSH_AUTHORIZED_KEYS=
SSH_PORT=2244
TENSORBOARD_PORT=6667
SHM_SIZE=32gb
